# Copy to .env and set your own local values (`make env` does this with a random DB password).
# Never use these placeholders in production.
SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=5433
DB_NAME=safetypad
DB_USER=safetypad
DB_PASSWORD=CHANGE_ME_LOCALLY
# 지도: mock(키 없는 대체 지도) | kakao. kakao 는 developers.kakao.com 의 'JavaScript 키'를 MAP_API_KEY 에 넣고,
# 같은 앱의 [플랫폼 > Web]에 접속 도메인(예: http://localhost:5173)을 등록해야 합니다. REST/Admin 키는 넣지 마세요.
MAP_PROVIDER=mock
MAP_API_KEY=
LOCATION_PING_INGEST_ENABLED=false
SIMULATED_DATA_ENABLED=true
# Server-side secret for keyed device-key digests (>= 32 chars). Rotating it invalidates all issued keys.
DEVICE_KEY_PEPPER=CHANGE_ME_LOCALLY
# First admin account, created ONLY when no admin exists. Password >= 12 chars. There is no built-in default account.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_LOCALLY
# Prometheus scrape identity for /actuator/prometheus (password >= 16 chars; blank = endpoint denied)
METRICS_USERNAME=metrics
METRICS_PASSWORD=CHANGE_ME_LOCALLY
# Feature flag: GPS-ping route view. Production default is false until the firmware ping contract is approved.
ROUTE_ENABLED=true
# Dev profile only: comma-separated simulated devices to register + issue keys for (keys go to .dev-secrets/)
DEV_PROVISION_DEVICES=

# --- MQTT 수신 (선택) -------------------------------------------------------------
# 기기가 REST 대신 MQTT로 이벤트를 보내게 하려면 true. 자세한 규격: docs/MQTT_INTEGRATION.md
# 로컬 개발(dev)은 127.0.0.1:MQTT_PORT 평문 허용, 운영은 TLS(MQTT_TLS_PORT)만 허용됩니다.
MQTT_ENABLED=false
MQTT_PORT=1883
# 운영/TLS: PKCS12 키스토어 경로와 비밀번호 (실제 값은 deploy/.env.prod 에만, 커밋 금지)
MQTT_TLS_PORT=8883
MQTT_KEYSTORE_PATH=
MQTT_KEYSTORE_PASSWORD=
