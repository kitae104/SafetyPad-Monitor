# Copy to deploy/.env.prod and fill EVERY value. Never commit the real file. Generate secrets with: openssl rand -hex 32
DOMAIN=monitor.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443
DB_NAME=safetypad
DB_USER=safetypad
DB_PASSWORD=
DEVICE_KEY_PEPPER=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
METRICS_USERNAME=metrics
METRICS_PASSWORD=
INGEST_PER_KEY_PER_MINUTE=120
INGEST_PER_IP_PER_MINUTE=600

# --- MQTT 수신 (선택, 기본 꺼짐) --------------------------------------------------
# true 로 바꾸기 전에 docs/MQTT_INTEGRATION.md 의 TLS 인증서 준비 절차를 끝내세요.
MQTT_ENABLED=false
MQTT_KEYSTORE_DIR=./mqtt-keystore
MQTT_KEYSTORE_PASSWORD=
# 외부(기기)에서 접속하게 하려면 0.0.0.0 (방화벽/보안그룹에서 8883 허용 필요). 기본은 서버 내부(127.0.0.1)만.
MQTT_PUBLISH_BIND=127.0.0.1
